# Wise Q Hermes Integration Environment Variables

# Wise Q API Configuration
WQ_API_KEY=your_wiseq_api_key_here
WQ_API_BASE_URL=https://api.wiseq.nl

# Hermes AI Configuration
HERMES_DASHBOARD_URL=https://dashboard.hermes.ai
HERMES_API_KEY=your_hermes_api_key_here

# AIW Configuration
AIW_CONFIG_PATH=/opt/data/.hermes/config
LOG_LEVEL=INFO

# Database Configuration (if using external database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wiseq_hermes
DB_USER=wiseq_user
DB_PASSWORD=your_db_password

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Gateway Configuration
API_RATE_LIMIT=1000/hour
API_TIMEOUT=30
API_MAX_RETRIES=3

# Monitoring Configuration
PROMETHEUS_ENDPOINT=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your_grafana_api_key

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# Logging Configuration
LOG_FILE=/app/logs/wiseq-hermes.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=json

# Feature Flags
ENABLE_B2B_PRICING=true
ENABLE_MARKET_RESEARCH=true
ENABLE_CUSTOMER_SUPPORT=true
ENABLE_COMPLIANCE_MONITORING=true
ENABLE_PERFORMANCE_ANALYTICS=true

# Development Settings (set to false in production)
DEBUG=false
TESTING=false

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/wiseq.crt
SSL_KEY_PATH=/etc/ssl/private/wiseq.key

# External Services
SENTRY_DSN=your_sentry_dsn_here
SLACK_WEBHOOK_URL=your_slack_webhook_here
EMAIL_SERVICE_URL=your_email_service_url